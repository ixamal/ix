{
  "name": "ix",
  "version": "0.1.0",
  "private": true,
  "description": "IX Valhalla — Cursor control plane for local Ollama, UE5, DCC, DAW, and DJ bridges.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 47241",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 47241",
    "lint": "eslint",
    "runtime": "PYTHONPATH=runtime python3 -m ix_runtime --host 127.0.0.1 --osc-port 9000 --http-port 9100 --control-url http://127.0.0.1:47241",
    "crate": "PYTHONPATH=crate python3 -m ix_crate unknown-album",
    "test": "PYTHONPATH=runtime python3 -m pytest runtime/tests -q && cd crate && PYTHONPATH=. python3 -m unittest tests.test_identify -q",
    "setup:local": "bash scripts/install-local-tools.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
